# CI workflow using shared actions from tylerbutler/actions
# Rename to ci.yml to use this instead of the local setup action
# Delete .github/actions/setup/ directory if using this

name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_call:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    name: Test
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false

      - name: Setup environment
        uses: tylerbutler/actions/setup-gleam@ee7def5950abcf0a519add705a95719ab345c05e

      - name: Check formatting
        run: just format-check

      - name: Type check
        run: just check

      - name: Build (warnings as errors)
        run: just build-strict

      - name: Run tests
        run: just test

  docs:
    runs-on: ubuntu-latest
    name: Docs
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false

      - name: Setup environment
        uses: tylerbutler/actions/setup-gleam@ee7def5950abcf0a519add705a95719ab345c05e

      - name: Build documentation
        run: just docs
