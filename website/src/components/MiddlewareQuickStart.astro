---
import CodeBlock from "./CodeBlock.astro";
import { getPackageEntry } from "../data/content";
import { registryCode, wispCode } from "../data/doc-snippets";

const mistPackage = await getPackageEntry("mist");
if (!mistPackage) throw new Error("The quick start requires the Mist package guide.");
---

<section id="wisp-route" data-middleware-example="wisp">
  <h3>Wisp route setup</h3>
  <p>Register the strategy and client configuration from the provider setup above.</p>
  <CodeBlock code={wispCode} lang="gleam" />
</section>

<details id="mist-route" class="middleware-example" data-middleware-example="mist">
  <summary>Mist route setup</summary>
  <div data-quick-start-dependencies>
    <p>Use the Mist middleware package instead of the Wisp middleware package.</p>
    <CodeBlock code={mistPackage.data.install.join("\n")} lang="toml" />
  </div>
  <p>
    Register the strategy and client configuration from the provider setup above.
  </p>
  <CodeBlock code={registryCode} lang="gleam" />
  <p>
    Load a high-entropy secret key base from configuration. Create the options
    and state store once, then use them in your Mist handler. For local HTTP
    development only, use <code>with_cookie_security(AllowInsecure)</code>.
    Keep secure cookies for HTTPS, including Apple.
  </p>
  <CodeBlock code={mistPackage.data.code} lang="gleam" />
</details>
