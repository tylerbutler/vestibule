---
import CodeBlock from "./CodeBlock.astro";

const gitSource = `git = "https://github.com/tylerbutler/vestibule.git", ref = "v0"`;
const dependencyLine = (name: string, path = "") =>
  `${name} = { ${gitSource}${path ? `, path = "${path}"` : ""} }`;

const routes = [
  {
    value: "wisp",
    label: "Wisp",
    packageName: "vestibule_wisp",
    path: "packages/vestibule_wisp",
    href: "#wisp-route",
    action: "Start the Wisp route setup"
  },
  {
    value: "mist",
    label: "Mist",
    packageName: "vestibule_mist",
    path: "packages/vestibule_mist",
    href: "#mist-route",
    action: "Start the Mist route setup"
  },
  {
    value: "core",
    label: "custom router",
    packageName: "",
    path: "",
    href: "#core-path",
    action: "Start the core route setup"
  }
];

const providers = [
  {
    value: "github",
    label: "GitHub",
    packageName: "vestibule_github",
    path: "packages/vestibule_github",
    href: "/docs/packages/github"
  },
  {
    value: "google",
    label: "Google",
    packageName: "vestibule_google",
    path: "packages/vestibule_google",
    href: "/docs/packages/google"
  },
  {
    value: "microsoft",
    label: "Microsoft",
    packageName: "vestibule_microsoft",
    path: "packages/vestibule_microsoft",
    href: "/docs/packages/microsoft"
  },
  {
    value: "apple",
    label: "Apple",
    packageName: "vestibule_apple",
    path: "packages/vestibule_apple",
    href: "/docs/packages/apple"
  }
];

const selections = routes.flatMap((route) =>
  providers.map((provider) => ({
    key: `${route.value}:${provider.value}`,
    route,
    provider,
    code: [
      "[dependencies]",
      dependencyLine("vestibule"),
      dependencyLine(provider.packageName, provider.path),
      ...(route.packageName ? [dependencyLine(route.packageName, route.path)] : [])
    ].join("\n")
  }))
);
---

<section id="selected-path" class="selected-path" data-selected-path hidden>
  {
    selections.map(({ key, route, provider, code }) => (
      <div
        class="selected-path-content"
        data-selected-config={key}
        data-server={route.value}
        data-provider={provider.value}
        hidden
      >
        <h2>{route.label} + {provider.label}</h2>
        <p>
          Add the dependency block to <code>gleam.toml</code>, then complete
          these two setup tasks. Your selection stays in the URL.
        </p>
        <details class="selected-path-install">
          <summary>Review your dependency block</summary>
          <CodeBlock code={code} lang="toml" />
        </details>
        <ol class="selected-path-steps">
          <li>
            <strong>Wire the request and callback routes.</strong>
            <a class="button primary" href={route.href} data-route-start>{route.action}</a>
          </li>
          <li>
            <strong>Configure {provider.label} before you test sign-in.</strong>
            <a class="text-link" href={provider.href}>Set up {provider.label}</a>
          </li>
        </ol>
        <a
          class="text-link"
          href={`/?server=${route.value}&provider=${provider.value}#get-started`}
        >
          Change choices
        </a>
      </div>
    ))
  }
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.querySelector("[data-selected-path]");
    if (!(container instanceof HTMLElement)) return;

    const params = new URLSearchParams(window.location.search);
    const server = params.get("server");
    const provider = params.get("provider");
    if (!server || !provider) return;

    const selected = Array.from(
      container.querySelectorAll("[data-selected-config]")
    ).find((item) => item.getAttribute("data-selected-config") === `${server}:${provider}`);

    if (!(selected instanceof HTMLElement)) return;

    selected.hidden = false;
    container.hidden = false;

    for (const dependencies of document.querySelectorAll("[data-quick-start-dependencies]")) {
      dependencies.hidden = true;
    }

    const routeLink = selected.querySelector("[data-route-start]");
    if (routeLink instanceof HTMLAnchorElement) {
      const routeTarget = document.getElementById(routeLink.hash.slice(1));
      if (routeTarget instanceof HTMLDetailsElement) routeTarget.open = true;
    }

    if (server === "wisp" || server === "mist") {
      for (const example of document.querySelectorAll("[data-middleware-example]")) {
        example.hidden = example.dataset.middlewareExample !== server;
      }
    }
  }, { once: true });
</script>
