---
import { siApple, siGithub, siGoogle } from "simple-icons";
import CodeBlock from "../components/CodeBlock.astro";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getPackageEntries, packageHref, packageSlug } from "../data/content";

const packageEntries = await getPackageEntries();
const packageBySlug = new Map(packageEntries.map((entry) => [packageSlug(entry), entry]));
const hrefForPackage = (slug: string) => {
  const entry = packageBySlug.get(slug);
  return entry ? packageHref(entry) : `/docs/packages/${slug}`;
};
const nameForPackage = (slug: string, fallback: string) =>
  packageBySlug.get(slug)?.data.name || fallback;
const supportedProviders = [
  {
    name: "GitHub",
    packageName: nameForPackage("github", "vestibule_github"),
    href: hrefForPackage("github"),
    note: "OAuth App sign-in with verified-primary-email lookup.",
    icon: siGithub
  },
  {
    name: "Google",
    packageName: nameForPackage("google", "vestibule_google"),
    href: hrefForPackage("google"),
    note: "OpenID Connect, email, profile, and hosted-domain helpers.",
    icon: siGoogle,
    color: `#${siGoogle.hex}`
  },
  {
    name: "Microsoft",
    packageName: nameForPackage("microsoft", "vestibule_microsoft"),
    href: hrefForPackage("microsoft"),
    note: "Microsoft Graph /me plus tenant-specific sign-in helpers.",
    icon: "microsoft"
  },
  {
    name: "Apple",
    packageName: nameForPackage("apple", "vestibule_apple"),
    href: hrefForPackage("apple"),
    note: "Sign in with Apple, JWKS-backed ID token verification, and form_post.",
    icon: siApple
  }
];
const directFlow = `// Request phase: failure here means misconfiguration, so assert is fine.
let assert Ok(auth_request) =
  vestibule.create_authorization_request(strategy, cfg)
// Store auth_request.state and auth_request.code_verifier, then
// redirect to auth_request.url.

// Callback phase: state can mismatch and providers can reject the
// user, so handle both branches instead of asserting.
case
  vestibule.handle_callback(
    strategy,
    cfg,
    params,
    expected_state,
    code_verifier,
  )
{
  Ok(auth) -> sign_in(auth)
  Error(error.StateMismatch) -> restart_sign_in()
  Error(reason) -> show_auth_error(reason)
}`;
const routeChoices = [
  {
    label: "Recommended for Wisp and Mist",
    title: "Start with middleware",
    recommended: true,
    body:
      "Let Wisp or Mist own request and callback routes while your app maps the normalized auth result to a user session.",
    href: "/docs/quick-start#middleware-path",
    action: "Use middleware",
    meta: "Add core, one provider strategy, and the middleware package for your server layer."
  },
  {
    label: "Advanced path",
    title: "Use core when your app owns the auth routes",
    body:
      "Choose core APIs when you want direct control over redirects, callback storage, and framework integration.",
    href: "/docs/quick-start#core-path",
    action: "Use core directly",
    meta: "Store state and PKCE verifier yourself before redirecting."
  },
  {
    label: "After the base flow works",
    title: "Add provider packages",
    body:
      "Add GitHub, Google, Microsoft, or Apple strategies when your sign-in flow needs provider-specific profile behavior.",
    href: "/docs/packages#provider-strategies",
    action: "Choose providers",
    meta: "Provider packages extend the base flow; they do not replace route handling."
  }
];
---

<DocsLayout
  title="Vestibule"
  description="Strategy-based OAuth2 authentication for Gleam."
  section="Overview"
>
  <section class="hero">
    <div class="hero-copy">
      <p class="intro-label">Strategy-based OAuth2 authentication for Gleam</p>
      <h1>OAuth sign-in for Gleam apps, without the guesswork.</h1>
      <p class="lead">
        Vestibule gives Gleam applications a consistent request/callback flow,
        normalized auth results, PKCE, CSRF state, provider strategies, and Wisp
        or Mist middleware without hiding the security responsibilities your app
        still owns.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/docs/quick-start">Add sign-in</a>
        <a class="button secondary" href="/docs/packages">Compare packages</a>
      </div>
      <ol class="hero-flow" aria-label="OAuth flow checkpoints">
        <li>
          <strong>Request</strong>
          <span>URL, state, PKCE verifier</span>
        </li>
        <li>
          <strong>Store</strong>
          <span>Bind transient callback data</span>
        </li>
        <li>
          <strong>Callback</strong>
          <span>Validate and normalize user info</span>
        </li>
      </ol>
    </div>
    <div class="hero-logo" aria-hidden="true">
      <img
        src="/logo.webp"
        alt=""
        width="451"
        height="453"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="route-decision" aria-labelledby="route-decision-heading">
    <div class="section-heading">
      <h2 id="route-decision-heading">Choose the route shape first.</h2>
      <p>
        Start with middleware when Wisp or Mist should own the auth routes. Use
        core only when your app handles routing, session storage, and callback
        data directly.
      </p>
    </div>
    <div class="route-choice-list">
      {routeChoices.map((choice) => (
        <a
          class:list={["route-choice", { recommended: choice.recommended }]}
          href={choice.href}
        >
          <span class="path-label">{choice.label}</span>
          <strong>{choice.title}</strong>
          <span>{choice.body}</span>
          <small>{choice.meta}</small>
          <em>{choice.action}</em>
        </a>
      ))}
    </div>
  </section>

  <section class="content-grid split">
    <div>
      <h2>Keep the callback boundary explicit.</h2>
      <p>
        Vestibule creates the authorization request and validates the callback.
        Your app still stores state and PKCE data before redirecting, then maps
        successful auth results to accounts.
      </p>
    </div>
    <CodeBlock code={directFlow} lang="gleam" class="code-card" />
  </section>

  <section aria-labelledby="supported-providers-heading">
    <div class="section-heading">
      <h2 id="supported-providers-heading">Supported providers</h2>
      <p>
        Start with GitHub from core, then add Google, Microsoft, or Apple when
        your app needs those provider-specific flows.
      </p>
    </div>
    <div class="provider-ledger" aria-label="Supported OAuth providers">
      {supportedProviders.map((provider) => (
        <a
          class="provider-link"
          href={provider.href}
          style={provider.color ? `--provider-color: ${provider.color}` : undefined}
        >
          <span class:list={["provider-mark", { "provider-mark-microsoft": provider.icon === "microsoft" }]} aria-hidden="true">
            {provider.icon === "microsoft" ? (
              <span class="microsoft-window">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </span>
            ) : (
              <svg viewBox="0 0 24 24" role="img" focusable="false">
                <path d={provider.icon.path}></path>
              </svg>
            )}
          </span>
          <span class="provider-copy">
            <strong>{provider.name}</strong>
            <small>{provider.packageName}</small>
          </span>
          <span>{provider.note}</span>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2>Packages follow the route shape.</h2>
      <p>
        Pick the routing layer first, then add provider strategies for the
        identity providers your app supports.
      </p>
    </div>
    <div class="package-river">
      <a class="package-row" href={hrefForPackage("wisp")}>
        <span>
          <strong>{nameForPackage("wisp", "vestibule_wisp")}</strong>
          <small>Wisp middleware</small>
        </span>
        <span>Use when your Wisp app should own request and callback routing helpers.</span>
      </a>
      <a class="package-row" href={hrefForPackage("mist")}>
        <span>
          <strong>{nameForPackage("mist", "vestibule_mist")}</strong>
          <small>Mist middleware</small>
        </span>
        <span>Use when your app runs directly on Mist and wants the same auth ergonomics.</span>
      </a>
      <a class="package-row" href={hrefForPackage("core")}>
        <span>
          <strong>{nameForPackage("core", "vestibule")}</strong>
          <small>Core package</small>
        </span>
        <span>Use when your app owns routing, transient callback storage, and framework integration.</span>
      </a>
    </div>
  </section>

  <section class="security-callout">
    <div>
      <h2>Secure defaults, explicit boundaries.</h2>
      <p>
        Vestibule creates strong state tokens, applies PKCE, validates callback
        state before surfacing provider details, and verifies the provider-specific
        data it owns. Your application still stores transient callback data,
        protects bearer credentials, and decides how users map to accounts.
      </p>
    </div>
    <a class="text-link" href="/docs/quick-start#security-responsibilities">
      Review caller responsibilities
    </a>
  </section>
</DocsLayout>
