---
import CodeBlock from "../components/CodeBlock.astro";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getPackageEntries, packageHref, packageSlug } from "../data/content";

const packageEntries = await getPackageEntries();
const packageBySlug = new Map(packageEntries.map((entry) => [packageSlug(entry), entry]));
const hrefForPackage = (slug: string) => {
  const entry = packageBySlug.get(slug);
  return entry ? packageHref(entry) : `/docs/packages/${slug}`;
};
const nameForPackage = (slug: string, fallback: string) =>
  packageBySlug.get(slug)?.data.name || fallback;
const supportedProviders = [
  {
    name: "GitHub",
    packageName: nameForPackage("github", "vestibule_github"),
    href: hrefForPackage("github"),
    path: "packages/vestibule_github"
  },
  {
    name: "Google",
    packageName: nameForPackage("google", "vestibule_google"),
    href: hrefForPackage("google"),
    path: "packages/vestibule_google"
  },
  {
    name: "Microsoft",
    packageName: nameForPackage("microsoft", "vestibule_microsoft"),
    href: hrefForPackage("microsoft"),
    path: "packages/vestibule_microsoft"
  },
  {
    name: "Apple",
    packageName: nameForPackage("apple", "vestibule_apple"),
    href: hrefForPackage("apple"),
    path: "packages/vestibule_apple"
  }
];
const routeOptions = [
  {
    value: "wisp",
    label: "Wisp",
    note: "Use middleware routes",
    packageName: "vestibule_wisp",
    path: "packages/vestibule_wisp",
    href: "/docs/quick-start#middleware-path"
  },
  {
    value: "mist",
    label: "Mist",
    note: "Use middleware handlers",
    packageName: "vestibule_mist",
    path: "packages/vestibule_mist",
    href: "/docs/quick-start#middleware-path"
  },
  {
    value: "core",
    label: "Another router",
    note: "Own the OAuth routes",
    packageName: "",
    path: "",
    href: "/docs/quick-start#core-path"
  }
];
const gitSource = `git = "https://github.com/tylerbutler/vestibule.git", ref = "v0"`;
const dependencyLine = (name: string, path = "") =>
  `${name} = { ${gitSource}${path ? `, path = "${path}"` : ""} }`;
const defaultInstallBlock = [
  "[dependencies]",
  dependencyLine("vestibule"),
  dependencyLine("vestibule_github", "packages/vestibule_github"),
  dependencyLine("vestibule_wisp", "packages/vestibule_wisp")
].join("\n");
const installBlocks = routeOptions.flatMap((route) =>
  supportedProviders.map((provider) => ({
    key: `${route.value}:${provider.packageName}`,
    code: [
      "[dependencies]",
      dependencyLine("vestibule"),
      dependencyLine(provider.packageName, provider.path),
      ...(route.packageName ? [dependencyLine(route.packageName, route.path)] : [])
    ].join("\n")
  }))
);
---

<DocsLayout
  title="Vestibule"
  description="Demo-ready OAuth sign-in for Gleam. Real auth flows for demos and prototypes — not audited, not for production."
  section="Overview"
>
  <section class="hero">
    <div class="hero-copy">
      <p class="intro-label">Demo-ready OAuth sign-in for Gleam</p>
      <h1>Real OAuth <span class="nowrap">sign-in</span> for your Gleam demo, in minutes.</h1>
      <p class="lead">
        Vestibule gives demos and prototypes a real provider round-trip: a
        consistent request and callback flow with normalized auth results,
        PKCE, CSRF state, provider strategies, and Wisp or Mist middleware.
        It has not been security audited — keep it out of production. Your
        app remains responsible for its user accounts and sessions.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#get-started">Build your install block</a>
        <a class="button secondary" href="/docs/quick-start">Read the quick start</a>
      </div>
    </div>
    <div class="hero-threshold" aria-label="The sign-in path through Vestibule">
      <p class="threshold-cap">Identity provider</p>
      <ol class="hero-flow" aria-label="OAuth flow checkpoints">
        <li>
          <span class="flow-marker" aria-hidden="true">1</span>
          <span class="flow-copy">
            <strong>Request</strong>
            <span>URL, state, PKCE verifier</span>
          </span>
        </li>
        <li>
          <span class="flow-marker" aria-hidden="true">2</span>
          <span class="flow-copy">
            <strong>Store</strong>
            <span>Bind transient callback data</span>
          </span>
        </li>
        <li>
          <span class="flow-marker" aria-hidden="true">3</span>
          <span class="flow-copy">
            <strong>Callback</strong>
            <span>Validate and normalize user info</span>
          </span>
        </li>
      </ol>
      <p class="threshold-cap threshold-cap-app">Signed-in session in your app</p>
    </div>
  </section>

  <section id="get-started" class="setup-guide" aria-labelledby="setup-heading">
    <div class="section-heading">
      <p class="intro-label">Start here</p>
      <h2 id="setup-heading">Build the dependency block for your app.</h2>
      <p>
        Choose your server and identity provider. Vestibule prepares the Git
        dependencies and links to the applicable implementation path.
      </p>
    </div>

    <form class="setup-builder" data-setup-builder hidden>
      <ol class="setup-progress" aria-label="Setup progress">
        <li aria-current="step" data-setup-progress="server">1. Server</li>
        <li data-setup-progress="provider">2. Provider</li>
        <li data-setup-progress="result">3. Install</li>
      </ol>

      <fieldset class="setup-panel" data-setup-panel="server">
        <legend>
          <span class="setup-legend-step">Step 1 of 3</span>
          <span class="setup-legend-copy" data-setup-focus tabindex="-1">Which server does your app use?</span>
        </legend>
        <div class="setup-options">
          {routeOptions.map((route, index) => (
            <label class="setup-option">
              <input
                type="radio"
                name="server"
                value={route.value}
                checked={index === 0}
                data-label={route.label}
                data-href={route.href}
              />
              <span>
                <strong>{route.label}</strong>
                <small>{route.note}</small>
              </span>
            </label>
          ))}
        </div>
        <div class="setup-actions">
          <button class="button primary" type="button" data-setup-next="provider">
            Choose a provider
          </button>
          <a class="text-link" href="/docs/quick-start#core-path">Compare route paths</a>
        </div>
      </fieldset>

      <fieldset class="setup-panel" data-setup-panel="provider">
        <legend>
          <span class="setup-legend-step">Step 2 of 3</span>
          <span class="setup-legend-copy" data-setup-focus tabindex="-1">Which provider should users sign in with?</span>
        </legend>
        <div class="setup-options">
          {supportedProviders.map((provider, index) => (
            <label class="setup-option">
              <input
                type="radio"
                name="provider"
                value={provider.packageName}
                checked={index === 0}
                data-label={provider.name}
                data-href={provider.href}
              />
              <span>
                <strong>{provider.name}</strong>
                <small>{provider.packageName}</small>
              </span>
            </label>
          ))}
        </div>
        <div class="setup-actions">
          <button class="button secondary" type="button" data-setup-back="server">Back</button>
          <button class="button primary" type="button" data-setup-next="result">
            Build dependency block
          </button>
        </div>
      </fieldset>

      <section class="setup-panel setup-result" data-setup-panel="result" aria-live="polite">
        <p class="setup-legend-step">Step 3 of 3</p>
        <h3 data-setup-focus tabindex="-1">
          The <span data-setup-result-title>Wisp + GitHub</span> dependency block is ready.
        </h3>
        <p>
          Add this block to <code>gleam.toml</code>. The quick start explains
          how to handle requests, callbacks, and sessions.
        </p>
        <div class="setup-code-options">
          {installBlocks.map((block) => (
            <div
              data-setup-code={block.key}
              hidden={block.code !== defaultInstallBlock}
            >
              <CodeBlock code={block.code} lang="toml" />
            </div>
          ))}
        </div>
        <div class="setup-actions">
          <button class="button secondary" type="button" data-setup-back="provider">Back</button>
          <a class="button primary" href="/docs/quick-start#middleware-path" data-setup-continue>
            Continue with Wisp
          </a>
        </div>
        <a class="text-link" href={supportedProviders[0].href} data-setup-provider-link>
          Review GitHub provider details
        </a>
      </section>
    </form>
    <noscript>
      <div class="setup-fallback">
        <p>Choose the route path in the quick start, then add a provider package.</p>
        <a class="button primary" href="/docs/quick-start">Open the quick start</a>
      </div>
    </noscript>
  </section>

  <section class="boundary-section" aria-labelledby="callback-boundary">
    <div class="section-heading">
      <h2 id="callback-boundary">Keep the callback boundary explicit.</h2>
      <p>Vestibule validates provider callbacks. Your app stores callback data and manages user sessions.</p>
    </div>
    <div class="responsibility-grid">
      <div>
        <h3>Vestibule handles</h3>
        <ul class="check-list">
          <li>Strong state values and PKCE</li>
          <li>Callback state validation</li>
          <li>Normalized provider identities</li>
        </ul>
      </div>
      <div>
        <h3>Your app handles</h3>
        <ul class="check-list">
          <li>Short-lived callback storage</li>
          <li>Account and session mapping</li>
          <li>Safe failure and retry UX</li>
        </ul>
      </div>
    </div>
    <a class="text-link" href="/docs/quick-start#security-responsibilities">
      Review your app's responsibilities
    </a>
  </section>

  <section class="security-callout">
    <div>
      <h2 id="wire-sign-in">Ready to wire sign-in into your demo?</h2>
      <p>
        Follow the request and callback path. Then connect the normalized auth
        result to your application's session.
      </p>
    </div>
    <a class="button primary" href="/docs/quick-start">
      Open the quick start
    </a>
  </section>

  <script is:inline>
    (() => {
      const builder = document.querySelector("[data-setup-builder]");
      if (!(builder instanceof HTMLFormElement)) return;

      const panels = Array.from(builder.querySelectorAll("[data-setup-panel]"));
      const progressItems = Array.from(builder.querySelectorAll("[data-setup-progress]"));
      const codeBlocks = Array.from(builder.querySelectorAll("[data-setup-code]"));
      const title = builder.querySelector("[data-setup-result-title]");
      const continueLink = builder.querySelector("[data-setup-continue]");
      const providerLink = builder.querySelector("[data-setup-provider-link]");

      const selected = (name) =>
        builder.querySelector(`input[name="${name}"]:checked`);

      const showPanel = (name, moveFocus = true) => {
        for (const panel of panels) {
          panel.hidden = panel.dataset.setupPanel !== name;
        }
        for (const item of progressItems) {
          if (item.dataset.setupProgress === name) {
            item.setAttribute("aria-current", "step");
          } else {
            item.removeAttribute("aria-current");
          }
        }
        if (moveFocus) {
          panels
            .find((panel) => panel.dataset.setupPanel === name)
            ?.querySelector("[data-setup-focus]")
            ?.focus();
        }
      };

      const updateResult = () => {
        const server = selected("server");
        const provider = selected("provider");
        if (!(server instanceof HTMLInputElement) || !(provider instanceof HTMLInputElement)) return;

        const selectedCode = `${server.value}:${provider.value}`;
        for (const block of codeBlocks) {
          block.hidden = block.dataset.setupCode !== selectedCode;
        }

        if (title) title.textContent = `${server.dataset.label} + ${provider.dataset.label}`;
        if (continueLink instanceof HTMLAnchorElement) {
          continueLink.href = server.dataset.href;
          continueLink.textContent = `Continue with ${server.dataset.label}`;
        }
        if (providerLink instanceof HTMLAnchorElement) {
          providerLink.href = provider.dataset.href;
          providerLink.textContent = `Review ${provider.dataset.label} provider details`;
        }
      };

      builder.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const next = target.closest("[data-setup-next]");
        if (next instanceof HTMLElement) {
          if (next.dataset.setupNext === "result") updateResult();
          showPanel(next.dataset.setupNext);
          return;
        }

        const back = target.closest("[data-setup-back]");
        if (back instanceof HTMLElement) {
          showPanel(back.dataset.setupBack);
          return;
        }
      });

      builder.hidden = false;
      showPanel("server", false);
    })();
  </script>
</DocsLayout>
