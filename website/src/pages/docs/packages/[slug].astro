---
import type { CollectionEntry } from "astro:content";
import CodeBlock from "../../../components/CodeBlock.astro";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import {
  getPackageEntries,
  packageReferenceUrl,
  packageSlug
} from "../../../data/content";

export async function getStaticPaths() {
  const packages = await getPackageEntries();

  return packages.map((pkg) => ({
    params: { slug: packageSlug(pkg) },
    props: { pkg }
  }));
}

type Props = { pkg: CollectionEntry<"packages"> };
const { pkg } = Astro.props;
const { data } = pkg;
const referenceUrl = packageReferenceUrl(pkg);
---

<DocsLayout
  title={data.name}
  description={data.summary}
  section="Packages"
  toc={[
    { href: "#when-to-use", label: "When to use it" },
    { href: "#install", label: "Install" },
    { href: "#setup", label: "Setup" },
    { href: "#usage", label: "Usage" },
    { href: "#handling", label: "Responsibilities" }
  ]}
>
  <article class="doc-page">
    <header class="doc-hero package-hero">
      <span class="chip">{data.kind}</span>
      <h1>{data.name}</h1>
      <p>{data.summary}</p>
    </header>

    <section class="content-grid split">
      <div id="when-to-use">
        <h2>When to use it</h2>
        <p>{data.useWhen}</p>
        {data.defaultScopes && (
          <p class="scope-note"><strong>Default scopes:</strong> {data.defaultScopes}</p>
        )}
      </div>
      <div id="install" class="install-card">
        <h2>Install</h2>
        <p>
          Vestibule packages are not published on Hex. Add them from GitHub
          using the moving <code>vestibule-v0.0</code> tag. Gleam 1.18 or later
          is required because companion packages use Git path dependencies.
        </p>
        <CodeBlock code={data.install.join("\n")} lang="toml" />
        <nav class="resource-links" aria-label={`${data.name} package resources`}>
          <a href="/docs/installation">Installation guide</a>
          <a href={referenceUrl}>API reference</a>
          <a href="https://github.com/tylerbutler/vestibule">GitHub source</a>
        </nav>
      </div>
    </section>

    <section id="setup">
      <h2>Setup</h2>
      <ol class="setup-list">
        {data.setup.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section id="usage">
      <h2>Usage</h2>
      <CodeBlock code={data.code} lang="gleam" />
    </section>

    <section id="handling" class="content-grid">
      <div>
        <h2>What Vestibule handles</h2>
        <ul class="check-list">
          {data.highlights.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h2>What you handle</h2>
        <ul class="check-list warning">
          {data.notes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <nav class="next-links" aria-label="Package navigation">
      <a href="/docs/packages">Back to package overview</a>
      <a href={referenceUrl}>Read the API reference</a>
      <a href="/docs/guides/custom-strategy">Write a custom strategy</a>
    </nav>
  </article>
</DocsLayout>
