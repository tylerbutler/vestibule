---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { getPackageEntries, packageHref, packageSlug } from "../../../data/content";

const packages = await getPackageEntries();
const middleware = packages.filter((pkg) => pkg.data.kind.includes("middleware"));
const providers = packages.filter((pkg) => pkg.data.kind.includes("Provider"));
const core = packages.find((pkg) => packageSlug(pkg) === "core");
---

<DocsLayout
  title="Package overview"
  description="Choose the right Vestibule package for a Gleam OAuth integration."
  section="Packages"
  toc={[
    { href: "#core-package", label: "Core package" },
    { href: "#middleware-packages", label: "Middleware packages" },
    { href: "#provider-strategies", label: "Provider strategies" }
  ]}
>
  <article class="doc-page">
    <header class="doc-hero">
      <h1>Package overview</h1>
      <p>
        Vestibule is split by responsibility: core flow, transport middleware,
        and provider strategy packages.
      </p>
    </header>

    {core && (
      <section id="core-package" class="package-feature">
        <div>
          <span class="chip">Core</span>
          <h2>{core.data.name}</h2>
          <p>{core.data.summary}</p>
        </div>
        <a class="button primary" href={packageHref(core)}>Read core docs</a>
      </section>
    )}

    <section id="middleware-packages">
      <div class="section-heading">
        <h2>Middleware packages</h2>
        <p>Choose by your server routing layer.</p>
      </div>
      <div class="compare-list">
        {middleware.map((pkg) => (
          <a class="compare-item" href={packageHref(pkg)}>
            <span class="chip">{pkg.data.kind}</span>
            <strong>{pkg.data.name}</strong>
            <span>{pkg.data.useWhen}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="provider-strategies">
      <div class="section-heading">
        <h2>Provider strategies</h2>
        <p>Provider packages normalize profile data while preserving provider-specific security behavior.</p>
      </div>
      <table class="provider-table">
        <caption class="visually-hidden">Provider package comparison</caption>
        <thead>
          <tr>
            <th id="provider-package" scope="col">Package</th>
            <th id="provider-scopes" scope="col">Default scopes</th>
            <th id="provider-behavior" scope="col">Important behavior</th>
          </tr>
        </thead>
        <tbody>
          {providers.map((pkg) => (
            <tr>
              <th id={`provider-${packageSlug(pkg)}-package`} scope="row" headers="provider-package">
                <span class="provider-cell-label" aria-hidden="true">Package</span>
                <a href={packageHref(pkg)}><strong>{pkg.data.name}</strong></a>
              </th>
              <td headers={`provider-${packageSlug(pkg)}-package provider-scopes`}>
                <span class="provider-cell-label" aria-hidden="true">Default scopes</span>
                {pkg.data.defaultScopes || "Provider-owned"}
              </td>
              <td headers={`provider-${packageSlug(pkg)}-package provider-behavior`}>
                <span class="provider-cell-label" aria-hidden="true">Important behavior</span>
                {pkg.data.highlights[0]}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</DocsLayout>
