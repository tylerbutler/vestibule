---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { navGroups } from "../../data/navigation";
import { packageDocs } from "../../data/packages";

type SearchEntry = {
  title: string;
  href: string;
  category: string;
  description: string;
  terms: string;
  external?: boolean;
};

const pageEntries: SearchEntry[] = navGroups.flatMap((group) =>
  group.links.map((link) => ({
    title: link.label,
    href: link.href,
    category: group.title,
    description: `Open ${link.label.toLowerCase()} documentation.`,
    terms: `${group.title} ${link.label}`
  }))
);

const packageEntries: SearchEntry[] = packageDocs.flatMap((pkg) => [
  {
    title: `${pkg.name} package`,
    href: `/docs/packages/${pkg.slug}`,
    category: pkg.kind,
    description: pkg.summary,
    terms: `${pkg.name} ${pkg.kind} ${pkg.summary} ${pkg.useWhen} ${pkg.defaultScopes || ""} ${pkg.highlights.join(" ")} ${pkg.notes.join(" ")}`
  },
  {
    title: `${pkg.name} API docs`,
    href: `https://hexdocs.pm/${pkg.name}`,
    category: "API reference",
    description: `Open the HexDocs API reference for ${pkg.name}.`,
    terms: `${pkg.name} hexdocs api reference modules functions types`,
    external: true
  }
]);

const entries = Array.from(
  new Map([...pageEntries, ...packageEntries].map((entry) => [entry.href, entry])).values()
);
---

<DocsLayout
  title="Search docs"
  description="Search Vestibule documentation, package guides, and API references."
  section="Search"
>
  <article class="doc-page search-page" data-search-page>
    <header class="doc-hero">
      <h1>Search docs</h1>
      <p>
        Find the page, package, or API reference you need. Results stay visible
        without JavaScript; typing narrows them in place.
      </p>
    </header>

    <form class="search-form" role="search">
      <label for="docs-search">Search documentation</label>
      <input
        id="docs-search"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Try state, PKCE, callback errors, hosted domains"
        aria-describedby="docs-search-hint"
        data-search-input
      />
      <p id="docs-search-hint">
        Search covers docs pages, provider packages, OAuth concepts, and HexDocs
        API references.
      </p>
    </form>

    <p class="search-count" aria-live="polite" data-search-count>
      {entries.length} results
    </p>
    <p class="scope-note" hidden data-search-empty>
      No matching docs found. Try a provider name, package name, or OAuth term.
    </p>

    <ul class="search-results" data-search-results>
      {entries.map((entry) => (
        <li
          class="search-result"
          data-search-item
          data-search-text={`${entry.title} ${entry.category} ${entry.description} ${entry.terms}`.toLocaleLowerCase()}
        >
          <a
            href={entry.href}
            target={entry.external ? "_blank" : undefined}
            rel={entry.external ? "noopener noreferrer" : undefined}
            aria-label={entry.external ? `${entry.title}, opens in a new tab` : undefined}
          >
            <span class="chip">{entry.category}</span>
            <strong>{entry.title}</strong>
            <span>{entry.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </article>

  <script is:inline>
    (() => {
      const page = document.querySelector("[data-search-page]");
      if (!page) return;

      const input = page.querySelector("[data-search-input]");
      const count = page.querySelector("[data-search-count]");
      const empty = page.querySelector("[data-search-empty]");
      const items = Array.from(page.querySelectorAll("[data-search-item]"));

      if (!(input instanceof HTMLInputElement) || !count || !empty) return;

      const normalized = (value) =>
        value
          .toLocaleLowerCase()
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "");

      const render = () => {
        const terms = normalized(input.value).trim().split(/\s+/).filter(Boolean);
        let visible = 0;

        for (const item of items) {
          const text = normalized(item.dataset.searchText || "");
          const matches = terms.every((term) => text.includes(term));
          item.hidden = !matches;
          if (matches) visible += 1;
        }

        count.textContent = `${visible} result${visible === 1 ? "" : "s"}`;
        empty.hidden = visible > 0;
      };

      input.addEventListener("input", render);
      render();
    })();
  </script>
</DocsLayout>
