---
import { render, type CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { docsSlug, getDocsEntries } from "../../data/content";

export async function getStaticPaths() {
  const docs = await getDocsEntries({ includeHidden: true });

  return docs.map((entry) => ({
    params: { slug: docsSlug(entry) },
    props: { entry }
  }));
}

type Props = { entry: CollectionEntry<"docs"> };

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = entry.data.toc
  ? headings
      .filter((heading) => heading.depth === 2)
      .map((heading) => ({
        href: `#${heading.slug}`,
        label: heading.text
      }))
  : [];
---

<DocsLayout title={entry.data.title} description={entry.data.description} toc={toc}>
  <article class="doc-page">
    <header class="doc-hero">
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
    </header>
    <Content />
  </article>
</DocsLayout>
