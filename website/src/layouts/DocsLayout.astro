---
import { navGroups } from "../data/navigation";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  section?: string;
  toc?: Array<{
    href: string;
    label: string;
  }>;
};

const { title, description, section = "Docs", toc = [] } = Astro.props;
const pageTitle = title === "Vestibule" ? "Vestibule" : `${title} - Vestibule`;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, "") || "/";
  return currentPath === normalized;
};

const currentLink = navGroups
  .flatMap((group) => group.links)
  .find((link) => isActive(link.href));

const currentGroup = navGroups.find((group) =>
  group.links.some((link) => isActive(link.href))
);
const showBreadcrumbs = currentPath !== "/";
const breadcrumbLabel = currentLink?.label || title;
const hasToc = toc.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const storageKey = "vestibule-docs-theme";
        const root = document.documentElement;
        const stored = localStorage.getItem(storageKey);
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored || (prefersDark ? "dark" : "light");
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Vestibule documentation home">
        <img class="brand-mark" src="/icon.png" alt="" aria-hidden="true" />
        <span>
          <strong>Vestibule</strong>
          <small>OAuth2 for Gleam</small>
        </span>
      </a>
      <div class="header-actions">
        <a class="header-link" href="/docs/search">Search</a>
        <a class="header-link" href="https://hex.pm/packages/vestibule">Hex</a>
        <a class="header-link" href="https://github.com/tylerbutler/vestibule">GitHub</a>
        <button class="theme-toggle" type="button" data-theme-toggle>
          <span aria-hidden="true" data-theme-icon>◐</span>
          <span data-theme-label>Theme</span>
        </button>
      </div>
    </header>

    <div class="docs-frame">
      <aside class="sidebar" aria-label="Documentation navigation">
        <nav>
          {navGroups.map((group) => (
            <section class="nav-group">
              <h2>{group.title}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </aside>

      <main id="main-content" class="content-shell">
        <details class="mobile-nav">
          <summary>Docs menu{currentLink ? `: ${currentLink.label}` : ""}</summary>
          <nav aria-label="Mobile documentation navigation">
            {navGroups.map((group) => (
              <section class="nav-group">
                <h2>{group.title}</h2>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </nav>
        </details>

        {showBreadcrumbs && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Overview</a>
            {currentGroup && (
              <>
                <span aria-hidden="true">/</span>
                <span>{currentGroup.title}</span>
              </>
            )}
            <span aria-hidden="true">/</span>
            <span aria-current="page">{breadcrumbLabel}</span>
          </nav>
        )}
        {hasToc && (
          <nav class="page-toc" aria-label="On this page">
            <span>On this page</span>
            <ol>
              {toc.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ol>
          </nav>
        )}
        <slot />
      </main>
    </div>

    <script is:inline>
      (() => {
        const storageKey = "vestibule-docs-theme";
        const root = document.documentElement;
        const buttons = Array.from(document.querySelectorAll("[data-theme-toggle]"));

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          localStorage.setItem(storageKey, theme);
          const next = theme === "dark" ? "light" : "dark";
          for (const button of buttons) {
            button.setAttribute("aria-label", `Switch to ${next} mode`);
            const label = button.querySelector("[data-theme-label]");
            const icon = button.querySelector("[data-theme-icon]");
            if (label) label.textContent = theme === "dark" ? "Dark" : "Light";
            if (icon) icon.textContent = theme === "dark" ? "●" : "○";
          }
        };

        applyTheme(root.dataset.theme || "light");

        for (const button of buttons) {
          button.addEventListener("click", () => {
            applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
          });
        }
      })();

      (() => {
        const codeBlocks = Array.from(document.querySelectorAll("main pre"));
        if (codeBlocks.length === 0) return;

        const status = document.createElement("div");
        status.className = "visually-hidden";
        status.setAttribute("aria-live", "polite");
        document.body.append(status);

        const fallbackCopy = (text) =>
          new Promise((resolve, reject) => {
            const textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.setAttribute("readonly", "");
            textarea.style.position = "fixed";
            textarea.style.insetBlockStart = "0";
            textarea.style.insetInlineStart = "0";
            textarea.style.opacity = "0";
            document.body.append(textarea);
            textarea.select();

            try {
              const copied = document.execCommand("copy");
              textarea.remove();
              copied ? resolve() : reject(new Error("Copy command returned false"));
            } catch (error) {
              textarea.remove();
              reject(error);
            }
          });

        const writeClipboard = (text) => {
          if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text);
          }

          return fallbackCopy(text);
        };

        for (const block of codeBlocks) {
          if (block.parentElement?.classList.contains("code-copy")) continue;

          const wrapper = document.createElement("div");
          wrapper.className = "code-copy";
          const button = document.createElement("button");
          button.type = "button";
          button.className = "code-copy-button";
          button.textContent = "Copy";
          button.setAttribute("aria-label", "Copy code block");

          block.before(wrapper);
          wrapper.append(button, block);

          button.addEventListener("click", async () => {
            const text = block.textContent || "";

            if (text.trim().length === 0) {
              button.textContent = "Empty";
              button.dataset.copyState = "notice";
              status.textContent = "Code block is empty.";
              window.setTimeout(() => {
                button.textContent = "Copy";
                delete button.dataset.copyState;
              }, 1800);
              return;
            }

            button.disabled = true;
            button.dataset.copyState = "loading";

            try {
              await writeClipboard(text);
              button.textContent = "Copied";
              button.dataset.copyState = "success";
              status.textContent = "Code copied.";
            } catch (error) {
              button.textContent = "Failed";
              button.dataset.copyState = "error";
              status.textContent = "Copy failed. Select the code manually.";
            } finally {
              window.setTimeout(() => {
                button.textContent = "Copy";
                button.disabled = false;
                delete button.dataset.copyState;
              }, 1800);
            }
          });
        }
      })();
    </script>
  </body>
</html>
